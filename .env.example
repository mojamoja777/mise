# Mise 環境変数テンプレート
# `cp .env.example .env.local` した上で各値を埋めてください

# Supabase（Settings → API でコピー）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — Server Action / API Route 限定。クライアントに露出させないこと
SUPABASE_SERVICE_ROLE_KEY=

# 月次請求書 cron 認証（Vercel Cron からの呼び出し検証）
CRON_SECRET=

# Resend（メール通知。無くてもアプリは動くがメールは送られない）
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AI ラベル読み取り機能（デモフェーズ・無料クレジット枠）
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=

# 通知メール内のリンクの絶対 URL（未設定時は wine-saas.vercel.app）
NEXT_PUBLIC_APP_URL=
